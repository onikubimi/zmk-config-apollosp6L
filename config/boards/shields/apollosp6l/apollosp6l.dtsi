#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/mouse.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys = <&key_physical_attrs 100 100 100 35 0 0 0>    // [0,1]
             , <&key_physical_attrs 100 100 200 0 0 0 0>     // [0,2]
             , <&key_physical_attrs 100 100 300 (-25) 0 0 0> // [0,3]
             , <&key_physical_attrs 100 100 400 0 0 0 0>     // [0,4]
             , <&key_physical_attrs 100 100 500 25 0 0 0>    // [0,5]
             /* Row 1 */
             , <&key_physical_attrs 100 100 0 100 0 0 0>
             , <&key_physical_attrs 100 100 100 135 0 0 0>
             , <&key_physical_attrs 100 100 200 100 0 0 0>
             , <&key_physical_attrs 100 100 300 75 0 0 0>
             , <&key_physical_attrs 100 100 400 100 0 0 0>
             , <&key_physical_attrs 100 100 500 125 0 0 0>
             /* Row 2 */
             , <&key_physical_attrs 100 100 0 200 0 0 0>
             , <&key_physical_attrs 100 100 100 235 0 0 0>
             , <&key_physical_attrs 100 100 200 200 0 0 0>
             , <&key_physical_attrs 100 100 300 175 0 0 0>
             , <&key_physical_attrs 100 100 400 200 0 0 0>
             , <&key_physical_attrs 100 100 500 225 0 0 0>
             , <&key_physical_attrs 100 100 615 225 0 0 0>
             /* Row 3 */
             , <&key_physical_attrs 100 100 0 300 0 0 0>
             , <&key_physical_attrs 100 100 100 335 0 0 0>
             , <&key_physical_attrs 100 100 200 300 0 0 0>
             , <&key_physical_attrs 100 100 300 275 0 0 0>
             , <&key_physical_attrs 100 100 400 300 0 0 0>
             , <&key_physical_attrs 100 100 500 325 0 0 0>
             , <&key_physical_attrs 100 100 615 325 0 0 0>
             /* Row 4: 親指 */
             /* 幅 高 X座標 Y座標 回転角 ラベルX ラベルY */
             , <&key_physical_attrs 100 100 0 400 0 0 0>
             , <&key_physical_attrs 100 100 100 435 0 0 0>
             , <&key_physical_attrs 100 100 200 400 0 0 0>
             , <&key_physical_attrs 100 100 300 450 (0) 0 0>
             , <&key_physical_attrs 100 100 410 455 (1000) 0 0>
             , <&key_physical_attrs 100 100 520 475 (2000) 0 0>
             , <&key_physical_attrs 100 100 630 515 (3000) 0 0>;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <5>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
           = <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 0
           , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 1
           , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 2
           , <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // Row 3
           , <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // Row 4
        col-gpios
           = <&gpio0 17 GPIO_ACTIVE_LOW> // Col 0
           , <&gpio0 20 GPIO_ACTIVE_LOW> // Col 1
           , <&gpio0 22 GPIO_ACTIVE_LOW> // Col 2
           , <&gpio0 29 GPIO_ACTIVE_LOW> // Col 3
           , <&gpio0 11 GPIO_ACTIVE_LOW> // Col 4
           , <&gpio0 31 GPIO_ACTIVE_LOW> // Col 5
           , <&gpio0 9  GPIO_ACTIVE_LOW>; // Col 6
        };
};
